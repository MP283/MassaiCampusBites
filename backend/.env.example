# ---------------------------------------------------------------------------
# CampusBite backend configuration. Copy to backend/.env and fill in values.
# Never commit backend/.env - it is git-ignored.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Used by docker-compose for the PostgreSQL container AND to build DATABASE_URL
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=campusbite

# Local (non-Docker) runs: leave empty to use SQLite (backend/campusbite.db),
# or point at your own database, e.g. postgresql+psycopg2://user:pass@localhost:5432/campusbite
# (docker-compose overrides this automatically to use the "db" container)
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- OpenAI (AI order insights) ------------------------------------------------
# Leave empty to use the built-in offline insights
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=5

# --- Background reminders -------------------------------------------------------
REMINDER_MINUTES=15
REMINDER_CHECK_SECONDS=60

# --- Misc -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true
