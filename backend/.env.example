PORT=5000

# MongoDB. If it is not reachable, the server falls back to an in-memory database (data lost on restart)
MONGO_URI=mongodb://127.0.0.1:27017/ai_test_platform
MONGO_MEMORY_FALLBACK=true

JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# Free key from https://aistudio.google.com/apikey
# Leave empty to use the built-in offline question generator and keyword-based grading
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: path to tesseract.exe if it is not on PATH (images are OCR'd by Gemini when Tesseract is missing)
TESSERACT_CMD=

# SMTP for invitation emails. Leave SMTP_HOST empty to print emails in the backend console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Test Platform <no-reply@example.com>"
